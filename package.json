{
  "name": "reppilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 -H 0.0.0.0",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start -p 43123 -H 0.0.0.0",
    "lint": "eslint",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "email:test": "tsx scripts/send-test-email.ts",
    "postinstall": "prisma generate",
    "mobile:sync": "cap sync",
    "mobile:android": "cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.7",
    "iron-session": "^9.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.9",
    "mysql2": "3.24.6",
    "undici": "7.30.1"
  }
}
