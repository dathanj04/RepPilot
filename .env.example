# Copy to .env. Never commit real secrets.

# Local development. Hosted staging and production use separate Neon databases.
# DATABASE_URL is the pooled runtime URL. DIRECT_URL is the non-pooler URL Prisma migrations use.
DATABASE_URL="postgresql://reppilot:password@127.0.0.1:5432/reppilot"
DIRECT_URL="postgresql://reppilot:password@127.0.0.1:5432/reppilot"
DATABASE_URL_TEST="postgresql://reppilot:password@127.0.0.1:5432/reppilot_test"

# development | staging | production. Production refuses the demo seed.
APP_ENV="development"

# At least 32 characters. Used by iron-session to seal the login cookie.
SESSION_PASSWORD="replace-with-a-long-random-string"

# 32-byte key, base64. Encrypts secure-link tokens so a rep can copy them again.
TOKEN_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

CRON_SECRET="replace-with-a-random-string"
APP_URL="http://127.0.0.1:43123"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# Set to true only on a private demo host. Leave unset in production so seeded passwords are not shown.
NEXT_PUBLIC_DEMO_LOGIN=""

# Optional. The app runs without these and labels the missing integration.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="RepPilot <notifications@example.com>"
# Authorized inbox for `npm run email:test`. Never a clinic address.
TEST_EMAIL_TO=""

# Error monitoring. Both are optional until the accounts exist.
SENTRY_DSN=""
ALERT_WEBHOOK_URL=""

# Optional OAuth. Calendar and CRM stay disconnected until these are set and tested.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Reserved for a later billing phase. Do not put a live secret here for local demo.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
